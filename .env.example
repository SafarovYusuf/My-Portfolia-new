# Telegram Bot API credentials used by the contact form's serverless function
# (api/contact.js on Vercel, netlify/functions/contact.js on Netlify).
#
# Create a bot with @BotFather on Telegram to get a token, and message
# @userinfobot (or your bot itself) to find your numeric chat ID.
#
# Copy this file to `.env` for local development — never commit real values.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
